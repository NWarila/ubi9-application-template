#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${CRANE_STUB_LOG:-}" ]]; then printf '%s\n' "$*" >> "$CRANE_STUB_LOG"; fi
args=()
for arg in "$@"; do
  [[ "$arg" == --insecure ]] || args+=("$arg")
done
command=${args[0]:-}
case "$command" in
  digest)
    [[ "${CRANE_STUB_DIGEST_FAIL:-0}" != 1 ]] || exit 1
    ref=${args[1]:?}
    if [[ -n "${CRANE_STUB_DIGEST_MAP:-}" ]]; then
      value=$(awk -F '\t' -v ref="$ref" '$1 == ref {print $2; found=1} END {if (!found) exit 1}' "$CRANE_STUB_DIGEST_MAP") || exit 1
      printf '%s\n' "$value"
    else
      printf '%s\n' "${CRANE_STUB_DIGEST:?required}"
    fi
    ;;
  manifest)
    [[ "${CRANE_STUB_MANIFEST_FAIL:-0}" != 1 ]] || exit 1
    cat "${CRANE_STUB_INDEX:?required}"
    ;;
  config)
    [[ "${CRANE_STUB_CONFIG_FAIL:-0}" != 1 ]] || exit 1
    cat "${CRANE_STUB_CONFIG:?required}"
    ;;
  tag)
    [[ "${CRANE_STUB_TAG_FAIL:-0}" != 1 ]] || exit 1
    if [[ -n "${CRANE_STUB_TAG_SPY:-}" ]]; then printf '%s\n' "${args[*]}" >> "$CRANE_STUB_TAG_SPY"; fi
    ;;
  *) exit 2 ;;
esac
